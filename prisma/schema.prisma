generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  String                    @id @default(cuid())
  name                String?
  email               String                    @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  isAdmin             Boolean                   @default(false)
  accounts            Account[]
  ownedEvents         Event[]                   @relation("OwnedEvents")
  bringItems          EventBringItem[]
  bringParticipations EventBringParticipation[]
  eventInvitesSent    EventInvite[]             @relation("InvitedBy")
  eventMemberships    EventMember[]
  pollVotes           EventPollVote[]
  eventRelatives      EventRelative[]
  giftSuggestions     GiftItem[]                @relation("GiftItemSuggestedBy")
  giftLists           GiftList[]
  ideas               Idea[]
  managedProfiles     ManagedProfile[]
  reservations        Reservation[]
  sessions            Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  ownerId      String
  title        String
  description  String?
  eventOn      DateTime?
  location     String?
  colorHex     String            @default("#0ea5e9")
  linkEnabled  Boolean           @default(false)
  joinCode     String?           @unique
  slug         String            @unique
  budgetMode   EventBudgetMode   @default(NONE)
  budgetCents  Int?
  memberLimit  Int               @default(50)
  imagePath    String?           @db.VarChar(512)
  giftMode     EventGiftMode     @default(HOST_LIST)
  status       EventStatus       @default(PLANNING)
  locationMode EventLocationMode @default(TBD)
  scheduleMode EventScheduleMode @default(TBD)
  eventTime    String?           @db.VarChar(5)
  owner        User              @relation("OwnedEvents", fields: [ownerId], references: [id], onDelete: Cascade)
  budget       Budget?
  bringItems   EventBringItem[]
  invites      EventInvite[]
  memberships  EventMember[]
  modules      EventModule[]
  polls        EventPoll[]
  timelineMoments EventTimelineMoment[]
  relatives    EventRelative[]
  lists        GiftList[]
  inviteTokens InviteToken[]     @relation("Event_InviteTokens")
  vendors      Vendor[]

  @@index([ownerId, status])
  @@index([ownerId, eventOn])
}

model EventTimelineMoment {
  id              String                  @id @default(cuid())
  eventId         String
  title           String
  kind            EventTimelineMomentKind @default(other)
  startsAt        DateTime
  endsAt          DateTime?
  locationName    String?
  locationAddress String?
  note            String?
  position        Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@index([eventId, position])
}

model EventModule {
  id                  String                    @id @default(cuid())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  eventId             String
  key                 EventModuleKey
  enabled             Boolean                   @default(true)
  position            Int
  chatSettings        EventChatSettings?
  expensesSettings    EventExpensesSettings?
  giftsSettings       EventGiftsSettings?
  event               Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  overviewSettings    EventOverviewSettings?
  pollsSettings       EventPollsSettings?
  potluckSettings     EventPotluckSettings?
  secretSantaSettings EventSecretSantaSettings?
  timelineSettings    EventTimelineSettings?

  @@unique([eventId, key])
  @@index([eventId, enabled])
  @@index([eventId, position])
}

model EventGiftsSettings {
  id                 String      @id @default(cuid())
  eventModuleId      String      @unique
  isNoSpoil          Boolean     @default(true)
  isAnonReservations Boolean     @default(true)
  isSecondHandOk     Boolean     @default(false)
  isHandmadeOk       Boolean     @default(false)
  budgetCapCents     Int?
  eventModule        EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventSecretSantaSettings {
  id             String      @id @default(cuid())
  eventModuleId  String      @unique
  budgetCapCents Int?
  eventModule    EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventPotluckSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventTimelineSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventExpensesSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String       @id @default(cuid())
  eventId      String       @unique
  totalBudget  Decimal      @db.Decimal(12, 2)
  setupStatus  BudgetSetupStatus @default(NOT_STARTED)
  currency     String       @default("EUR")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lines        BudgetLine[]
}

model BudgetLine {
  id              String                   @id @default(cuid())
  budgetId        String
  category        BudgetLineCategory
  label           String
  targetAmount    Decimal                  @db.Decimal(12, 2)
  estimatedAmount Decimal?                 @db.Decimal(12, 2)
  sourcingStatus  BudgetLineSourcingStatus @default(DRAFT)
  internalNote    String?
  selectedQuoteId String?                  @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  budget          Budget                   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  selectedQuote   Quote?                   @relation("SelectedBudgetLineQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  quotes          Quote[]                  @relation("BudgetLineQuotes")
  payments        PaymentEntry[]

  @@index([budgetId, category])
  @@index([budgetId, sourcingStatus])
}

model Vendor {
  id          String   @id @default(cuid())
  eventId      String
  name         String
  vendorType   String?
  contactName  String?
  email        String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotes       Quote[]

  @@index([eventId, name])
}

model Quote {
  id            String      @id @default(cuid())
  budgetLineId  String
  vendorId      String
  status        QuoteStatus @default(AWAITING_RESPONSE)
  amount        Decimal?    @db.Decimal(12, 2)
  scope         String?
  requestedAt   DateTime?
  receivedAt    DateTime?
  validUntil    DateTime?
  internalNote  String?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  budgetLine    BudgetLine  @relation("BudgetLineQuotes", fields: [budgetLineId], references: [id], onDelete: Cascade)
  vendor        Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attachments   QuoteAttachment[]
  paymentEntries PaymentEntry[]
  selectedByLine BudgetLine? @relation("SelectedBudgetLineQuote")

  @@index([budgetLineId, status])
  @@index([vendorId, status])
}

model QuoteAttachment {
  id            String   @id @default(cuid())
  quoteId       String
  fileName      String
  fileUrl       String
  mimeType      String?
  fileSizeBytes Int?
  createdAt     DateTime @default(now())
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model PaymentEntry {
  id           String           @id @default(cuid())
  budgetLineId String
  quoteId      String?
  label        String
  entryType    PaymentEntryType
  amount       Decimal          @db.Decimal(12, 2)
  dueDate      DateTime
  paidAt       DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  budgetLine   BudgetLine       @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  quote        Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([budgetLineId, dueDate])
  @@index([quoteId])
  @@index([paidAt])
}

model EventPollsSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventChatSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventOverviewSettings {
  id            String      @id @default(cuid())
  eventModuleId String      @unique
  rsvpRequired  Boolean     @default(true)
  eventModule   EventModule @relation(fields: [eventModuleId], references: [id], onDelete: Cascade)
}

model EventMember {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  eventId         String
  userId          String
  role            EventMemberRole @default(MEMBER)
  rsvpRespondedAt DateTime?
  rsvpStatus      EventRsvpStatus @default(PENDING)
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId], name: "userId_eventId")
  @@index([userId])
  @@index([eventId])
}

model EventInvite {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  eventId     String
  email       String
  role        EventMemberRole @default(MEMBER)
  token       String          @unique
  status      InviteStatus    @default(PENDING)
  invitedById String
  expiresAt   DateTime
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy   User            @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([email])
}

model GiftList {
  id              String         @id @default(cuid())
  title           String         @default("Ma liste")
  ownerId         String?
  eventId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  eventRelativeId String?        @unique
  items           GiftItem[]
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventRelative   EventRelative? @relation(fields: [eventRelativeId], references: [id], onDelete: Cascade)
  owner           User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, eventId], name: "owner_event_unique")
  @@index([eventId])
  @@index([ownerId])
  @@index([eventRelativeId])
}

model GiftItem {
  id                String        @id @default(cuid())
  listId            String
  title             String
  url               String?
  priceCents        Int?
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  imagePath         String?       @db.VarChar(512)
  isSuggestion      Boolean       @default(false)
  suggestedByUserId String?
  list              GiftList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  suggestedByUser   User?         @relation("GiftItemSuggestedBy", fields: [suggestedByUserId], references: [id])
  ideas             Idea[]
  reservations      Reservation[]

  @@index([listId])
  @@index([suggestedByUserId])
}

model Reservation {
  id        String            @id @default(cuid())
  itemId    String
  byUserId  String
  status    ReservationStatus @default(RESERVED)
  anonymous Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  byUser    User              @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  item      GiftItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, status])
  @@index([byUserId, status])
}

model Idea {
  id        String   @id @default(cuid())
  itemId    String
  byUserId  String
  text      String
  anonymous Boolean  @default(true)
  createdAt DateTime @default(now())
  byUser    User     @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  item      GiftItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([byUserId])
}

model SecretSantaAssignment {
  id         String   @id @default(cuid())
  eventId    String
  giverId    String
  receiverId String
  createdAt  DateTime @default(now())

  @@unique([eventId, giverId], name: "eventId_giverId")
}

model InviteToken {
  id            String    @id @default(cuid())
  eventId       String
  code          String    @unique
  remainingUses Int       @default(1)
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  event         Event     @relation("Event_InviteTokens", fields: [eventId], references: [id], onDelete: Cascade)
}

model RateLimitHit {
  id  String   @id @default(cuid())
  key String
  ts  DateTime @default(now())

  @@index([key, ts])
}

model EventBringItem {
  id          String                    @id @default(cuid())
  label       String
  category    BringCategory?
  note        String?
  eventId     String
  createdById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  createdBy   User?                     @relation(fields: [createdById], references: [id])
  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bringers    EventBringParticipation[]

  @@index([eventId])
  @@index([createdById])
}

model EventBringParticipation {
  id          String         @id @default(cuid())
  itemId      String
  userId      String?
  displayName String?
  createdAt   DateTime       @default(now())
  item        EventBringItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@index([itemId])
  @@index([userId])
}

model ManagedProfile {
  id             String          @id @default(cuid())
  ownerId        String
  firstName      String
  birthYear      Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  eventRelatives EventRelative[]
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model EventRelative {
  id               String          @id @default(cuid())
  eventId          String
  createdById      String
  managedProfileId String?
  firstName        String
  birthYear        Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  managedProfile   ManagedProfile? @relation(fields: [managedProfileId], references: [id])
  giftList         GiftList?

  @@index([eventId])
  @@index([managedProfileId])
}

model EventPoll {
  id                String                 @id @default(cuid())
  eventId           String
  type              EventPollType
  status            EventPollStatus        @default(OPEN)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  closedAt          DateTime?
  closedReason      EventPollClosedReason?
  finalizedOptionId String?                @unique
  isActive          Boolean                @default(true)
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  finalizedOption   EventPollOption?       @relation("PollFinalizedOption", fields: [finalizedOptionId], references: [id])
  options           EventPollOption[]
  votes             EventPollVote[]

  @@index([eventId, type, isActive])
  @@index([eventId, type])
}

model EventPollOption {
  id              String          @id @default(cuid())
  pollId          String
  sort            Int             @default(0)
  dateValue       DateTime?
  textValue       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  finalizedByPoll EventPoll?      @relation("PollFinalizedOption")
  poll            EventPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes           EventPollVote[]

  @@unique([pollId, sort])
  @@index([pollId])
}

model EventPollVote {
  id           String          @id @default(cuid())
  pollId       String
  pollOptionId String
  byUserId     String
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [byUserId], references: [id], onDelete: Cascade)
  poll         EventPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option       EventPollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, byUserId])
  @@index([pollId])
  @@index([pollOptionId])
  @@index([byUserId])
  @@index([pollId, byUserId])
}

enum EventScheduleMode {
  TBD
  EXACT
  POLL
}

enum EventLocationMode {
  TBD
  EXACT
  POLL
}

enum EventPollType {
  SCHEDULE
  LOCATION
}

enum EventPollStatus {
  OPEN
  CLOSED
}

enum EventPollClosedReason {
  FINAL_SET
  HOST_CLOSED
  REPLACED
}

enum EventStatus {
  PLANNING
  ACTIVE
}

enum EventBudgetMode {
  NONE
  FIXED
}

enum EventMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventRsvpStatus {
  PENDING
  GOING
  MAYBE
  NOT_GOING
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum ReservationStatus {
  RESERVED
  PURCHASED
  RELEASED
}

enum EventGiftMode {
  HOST_LIST
  PERSONAL_LISTS
}

enum BringCategory {
  DRINKS
  FOOD
  GEAR
  OTHER
}

enum ParticipantKind {
  USER
  MANAGED
}

enum EventModuleKey {
  OVERVIEW
  GIFTS
  SECRET_SANTA
  POTLUCK
  TIMELINE
  EXPENSES
  POLLS
  CHAT
}

enum EventTimelineMomentKind {
  ceremony
  reception
  meal
  party
  transport
  other
}

enum BudgetLineCategory {
  VENUE
  FOOD_BEVERAGE
  DESIGN_DECORATION
  ENTERTAINMENT
  LOGISTICS
  GUEST_EXPERIENCE
  COMMUNICATION
  MISCELLANEOUS
}

enum BudgetLineSourcingStatus {
  DRAFT
  SOURCING
  QUOTES_RECEIVED
  SELECTED
  BOOKED
}

enum QuoteStatus {
  AWAITING_RESPONSE
  RECEIVED
  SELECTED
  REJECTED
}

enum PaymentEntryType {
  DEPOSIT
  BALANCE
  OTHER
}

enum BudgetSetupStatus {
  NOT_STARTED
  STARTED
}
